# TrueFit AR - unit cube for Module 3 (Dimension-Verified Fit Check)
# 1m x 1m x 1m box, base sits at y=0 so it stands on the detected floor plane.
# Scaled per-item at runtime to match user-entered real-world dimensions.
mtllib unit_cube.mtl
o unit_cube
v -0.5 0.0 -0.5
v  0.5 0.0 -0.5
v  0.5 0.0  0.5
v -0.5 0.0  0.5
v -0.5 1.0 -0.5
v  0.5 1.0 -0.5
v  0.5 1.0  0.5
v -0.5 1.0  0.5
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0
vn 0.0 -1.0 0.0
vn 0.0 1.0 0.0
vn 0.0 0.0 -1.0
vn 0.0 0.0 1.0
vn 1.0 0.0 0.0
vn -1.0 0.0 0.0
usemtl unit_cube_material
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1
f 5/1/2 8/2/2 7/3/2
f 5/1/2 7/3/2 6/4/2
f 1/1/3 5/2/3 6/3/3
f 1/1/3 6/3/3 2/4/3
f 3/1/4 7/2/4 8/3/4
f 3/1/4 8/3/4 4/4/4
f 2/1/5 6/2/5 7/3/5
f 2/1/5 7/3/5 3/4/5
f 4/1/6 8/2/6 5/3/6
f 4/1/6 5/3/6 1/4/6
